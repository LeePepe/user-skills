#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

branch="$(git branch --show-current 2>/dev/null || true)"
if { [ "$branch" = "main" ] || [ "$branch" = "master" ]; } && [ "${ALLOW_MAIN_COMMIT:-0}" != "1" ]; then
  echo "❌ [pre-commit] Direct commits to '$branch' are forbidden." >&2
  echo "   Create a feature/fix branch or worktree and deliver via PR (or set ALLOW_MAIN_COMMIT=1 for emergency override)." >&2
  exit 1
fi

unset $(git rev-parse --local-env-vars)
exec "$REPO_ROOT/scripts/verify"
